# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─── Dual-key access control ───
FRC_ADMIN_KEY="change-me-admin-secret"
FRC_MEMBER_KEY="change-me-member-secret"

# Optional public copies (quick-login buttons in the UI):
# NEXT_PUBLIC_FRC_ADMIN_KEY="change-me-admin-secret"
# NEXT_PUBLIC_FRC_MEMBER_KEY="change-me-member-secret"

# ─── Start completely empty (no sample members / teams / events) ───
# When true, the SQL backend boots with zero rows until you add data or Reset Defaults.
FRC_START_CLEAN=true

# ─── Supabase / Postgres SQL backend (recommended) ───
# From Supabase → Project Settings → Database → Connection string → URI (Shared pooler)
# Example host: aws-0-us-west-2.pooler.supabase.com  port 6543
# Replace [YOUR-PASSWORD] with the real DB password (percent-encode special chars).
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres"

# Optional aliases:
# SUPABASE_DB_URL="postgresql://..."
# POSTGRES_URL="postgresql://..."

# Also works with Supabase JS API keys (if you prefer REST instead of DATABASE_URL):
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Optional local SQLite path when no DATABASE_URL is set:
# FRC_DATA_DIR="/tmp/frc-scouting-data"
