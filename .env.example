# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ─── Dual-key access control (REQUIRED for production) ───
# Login and API authorization use these values.
# Server-only (recommended — not exposed to the browser):
FRC_ADMIN_KEY="change-me-admin-secret"
FRC_MEMBER_KEY="change-me-member-secret"

# Optional aliases of the same:
# ADMIN_KEY="change-me-admin-secret"
# MEMBER_KEY="change-me-member-secret"

# Optional public copies (enables quick-login buttons in the UI).
# If you only set FRC_* secrets, users type the key manually.
# NEXT_PUBLIC_FRC_ADMIN_KEY="change-me-admin-secret"
# NEXT_PUBLIC_FRC_MEMBER_KEY="change-me-member-secret"

# Built-in defaults when unset (local demo only):
#   admin  = FRC-ADMIN-2025
#   member = FRC-MEMBER-TEAM

# Optional writable directory for local SQLite (defaults to ./data, then /tmp)
# FRC_DATA_DIR="/tmp/frc-scouting-data"

# ─── Supabase SQL Backend (recommended for real cloud SQL) ───
# Create a project at https://supabase.com → Settings → API
# 1) Run the SQL in supabase/schema.sql (SQL Editor)
# 2) Paste URL + keys below, then restart the dev server
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Service role bypasses RLS — keep secret, server-only (preferred for clear/seed)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional aliases
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
