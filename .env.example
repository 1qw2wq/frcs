# GEMINI_API_KEY: Required for Gemini AI API calls (if you use AI features).
# GEMINI_API_KEY="your-gemini-key"

# APP_URL: The URL where this applet is hosted.
# APP_URL="https://your-app.example.com"

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED — dual-key access (NO built-in defaults; app will reject login
# until these are set)
# ═══════════════════════════════════════════════════════════════════════════
# Admin signs in with FRC_ADMIN_KEY only.
# Members register once with: name + personal password + FRC_MEMBER_KEY,
# then later sign in with name + password only.
# API calls still authorize with the shared member token under the hood.
FRC_ADMIN_KEY="replace-with-your-admin-secret"
FRC_MEMBER_KEY="replace-with-your-member-secret"

# Optional: expose the same values to the browser for quick-fill only.
# Prefer keeping secrets server-only (FRC_* without NEXT_PUBLIC_).
# NEXT_PUBLIC_FRC_ADMIN_KEY="replace-with-your-admin-secret"
# NEXT_PUBLIC_FRC_MEMBER_KEY="replace-with-your-member-secret"

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED for empty start (recommended for production / first tournament)
# ═══════════════════════════════════════════════════════════════════════════
FRC_START_CLEAN=true

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED for Supabase Postgres (cloud SQL) — pick ONE connection style
# ═══════════════════════════════════════════════════════════════════════════
# A) Direct Postgres pooler URI (preferred)
# Supabase → Project Settings → Database → Connection string → URI (pooler)
# Host example: aws-0-us-west-2.pooler.supabase.com  port 6543
# User example: postgres.YOUR_PROJECT_REF
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres"

# Aliases (any one works):
# SUPABASE_DB_URL="postgresql://..."
# POSTGRES_URL="postgresql://..."
# POSTGRES_PRISMA_URL="postgresql://..."

# Force SSL if needed:
# DATABASE_SSL=true
# PGSSLMODE=require

# B) Supabase JS REST (optional alternative / in addition)
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# SUPABASE_ANON_KEY="eyJ..."

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL — local SQLite fallback when DATABASE_URL is unset
# ═══════════════════════════════════════════════════════════════════════════
# FRC_DATA_DIR="/tmp/frc-scouting-data"
